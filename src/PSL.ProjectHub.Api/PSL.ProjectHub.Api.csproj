<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\PSL.ProjectHub.Application\PSL.ProjectHub.Application.csproj" />
    <ProjectReference Include="..\PSL.ProjectHub.Infrastructure\PSL.ProjectHub.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Frontend kaynak dizini (API projesine göreli) -->
    <FrontendProjectDir>$(MSBuildThisFileDirectory)..\..\src\PSL.ProjectHub.Web</FrontendProjectDir>
  </PropertyGroup>

  <!--
    Frontend Derleme ve Dağıtım Hattı (Build & Publish Pipeline):
    Release modunda veya dotnet publish çalıştırıldığında React ön yüzü otomatik derlenir
    ve wwwroot çıktı hedefine hatasız olarak dahil edilir.
  -->
  <Target Name="BuildFrontendOnPublish" BeforeTargets="BeforePublish">
    <Message Text="[PSL Project Hub] Ön yüz (Vite) derleme süreci başlatılıyor..." Importance="high" />
    <Exec Command="npm run build" WorkingDirectory="$(FrontendProjectDir)" ConsoleToMSBuild="true" />

    <!-- Ön yüz dist/ içeriğini wwwroot/ içerisine aktar -->
    <ItemGroup>
      <DistFiles Include="$(FrontendProjectDir)\dist\**\*" />
    </ItemGroup>

    <Copy
      SourceFiles="@(DistFiles)"
      DestinationFiles="@(DistFiles->'$(MSBuildThisFileDirectory)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Message Text="[PSL Project Hub] Ön yüz başarıyla derlendi ve wwwroot'a aktarıldı." Importance="high" />
  </Target>

  <Target Name="IncludeFrontendInPublishOutput" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_WebFiles Include="$(FrontendProjectDir)\dist\**\*" />
      <ResolvedFileToPublish Include="@(_WebFiles)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
